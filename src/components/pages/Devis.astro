---
/**
 * LA DEMANDE DE DEVIS.
 *
 * Sept questions, dont quatre se répondent d'un doigt. C'est la page la plus
 * importante du site après l'accueil, et elle est dessinée POUR LE POUCE :
 * grandes cartes à cocher, incrémenteur, listes courtes, et un seul champ
 * libre tout en bas.
 *
 * ELLE FONCTIONNE SANS UNE LIGNE DE SCRIPT. Le formulaire est posté en
 * « multipart/form-data » vers une fonction qui vérifie, puis REDIRIGE vers la
 * page de confirmation. Un formulaire qui répondrait du JSON brut à un
 * navigateur sans script lui afficherait du code à la place d'un remerciement.
 *
 * LA LISTE DES COMMUNES N'EST PAS ÉCRITE ICI : elle se lit dans zone.groupes,
 * qui est sa source. Une commune ajoutée à la zone d'intervention apparaît
 * dans ce menu du même geste, et les deux ne peuvent pas diverger.
 */
import contenu from '../../data/contenu.json';

const d = contenu.devis;
const communes = contenu.zone.groupes.flatMap((g) => g.communes).sort((a, b) => a.localeCompare(b, 'fr'));

/* LE BESOIN PASSÉ EN ADRESSE SE LIT DANS LE NAVIGATEUR, PAS ICI.

   La page est engendrée une fois pour toutes : au moment de la construire,
   « Astro.url.searchParams » est vide, et le restera. Lire la chaîne de
   requête ici revenait à ne jamais la lire — le contrôle d'interactions l'a
   relevé, la carte « Dépannage » restant sur « Installation ».

   La première carte est donc cochée par défaut dans le document — ce qui vaut
   aussi sans script — et un court script coche celle que l'adresse demande. */
const besoinsConnus = d.besoins.map((b) => b.id);
---

<section class="section section--premiere" aria-labelledby="devis-titre">
  <div class="enveloppe">
    <nav class="fil" aria-label={contenu.ui.navFil}>
      <ol class="fil__liste">
        <li><a class="fil__lien" href="/">{contenu.site.nom}</a></li>
        <li>
          <span class="fil__trait" aria-hidden="true">/</span>
          <span aria-current="page">{d.titre}</span>
        </li>
      </ol>
    </nav>

    <p class="rail" id="devis-titre">{d.rail}</p>
    <h1 class="devis__titre">{d.accroche}</h1>
    <p class="devis__intro">{d.intro}</p>
    <p class="note devis__demo">{contenu.demo.formulaire}</p>
  </div>
</section>

<section class="section section--suite" aria-label={d.titre}>
  <div class="enveloppe">
    <form
      class="formulaire"
      method="POST"
      action="/api/devis"
      enctype="multipart/form-data"
      accept-charset="utf-8"
    >
      {/* 1 · Le besoin ------------------------------------------------- */}
      <fieldset class="bloc">
        <legend class="bloc__titre">{d.besoinLabel}</legend>
        <div class="cartes">
          {
            d.besoins.map((b, i) => (
              <label class="carte">
                <input
                  class="carte__radio"
                  type="radio"
                  name="besoin"
                  value={b.id}
                  required
                  checked={i === 0}
                />
                <span class="carte__corps">
                  <span class="carte__nom">{b.nom}</span>
                  <span class="carte__detail">{b.detail}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      {/* 2 · La taille du chantier ------------------------------------- */}
      <div class="bloc bloc--duo">
        <p class="champ">
          <label class="champ__label" for="pieces">{d.piecesLabel}</label>
          {/* L'incrémenteur est un ENRICHISSEMENT : sans script, le champ
              numérique reste utilisable tel quel, avec le clavier du
              téléphone. */}
          <span class="compteur" data-compteur>
            <button class="compteur__bouton" type="button" data-pas="-1">
              <span aria-hidden="true">−</span>
              <span class="visuellement-cache">{d.piecesMoins}</span>
            </button>
            <input
              class="champ__saisie compteur__champ chiffre"
              type="number"
              id="pieces"
              name="pieces"
              min="1"
              max="12"
              step="1"
              value="1"
              inputmode="numeric"
            />
            <button class="compteur__bouton" type="button" data-pas="1">
              <span aria-hidden="true">+</span>
              <span class="visuellement-cache">{d.piecesPlus}</span>
            </button>
          </span>
          <span class="champ__aide">{d.piecesAide}</span>
        </p>

        <p class="champ">
          <label class="champ__label" for="surface">
            {d.surfaceLabel} <span class="champ__marque">({d.facultatif})</span>
          </label>
          <span class="unite">
            <input
              class="champ__saisie chiffre"
              type="number"
              id="surface"
              name="surface"
              min="5"
              max="600"
              step="1"
              inputmode="numeric"
            />
            <span class="unite__suffixe chiffre" aria-hidden="true">{d.surfaceUnite}</span>
          </span>
          <span class="champ__aide">{d.surfaceAide}</span>
        </p>
      </div>

      {/* 3 · Où et quand ----------------------------------------------- */}
      <div class="bloc">
        <p class="champ">
          <label class="champ__label" for="commune">{d.communeLabel}</label>
          <select class="champ__saisie" id="commune" name="commune" required>
            <option value="">{d.communeDefaut}</option>
            {communes.map((n) => <option value={n}>{n}</option>)}
          </select>
        </p>
      </div>

      <fieldset class="bloc">
        <legend class="bloc__titre">{d.delaiLabel}</legend>
        <div class="pastilles">
          {
            d.delais.map((x, i) => (
              <label class="pastille">
                <input type="radio" name="delai" value={x.id} required checked={i === 0} />
                <span>{x.nom}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      {/* 4 · Les photos ------------------------------------------------- */}
      <div class="bloc">
        <p class="champ">
          <label class="champ__label" for="photos">
            {d.photosLabel} <span class="champ__marque">({d.facultatif})</span>
          </label>
          <input
            class="champ__fichier"
            type="file"
            id="photos"
            name="photos"
            accept="image/*"
            multiple
            aria-describedby="photos-aide"
          />
          <span class="champ__aide" id="photos-aide">{d.photosAide}</span>
        </p>
      </div>

      {/* 5 · Vous ------------------------------------------------------- */}
      <div class="bloc bloc--duo">
        <p class="champ">
          <label class="champ__label" for="nom">
            {d.nomLabel} <span class="champ__marque">({d.obligatoire})</span>
          </label>
          <input class="champ__saisie" type="text" id="nom" name="nom" autocomplete="name" required />
        </p>

        <p class="champ">
          <label class="champ__label" for="telephone">
            {d.telephoneLabel} <span class="champ__marque">({d.obligatoire})</span>
          </label>
          <input
            class="champ__saisie chiffre"
            type="tel"
            id="telephone"
            name="telephone"
            autocomplete="tel"
            inputmode="tel"
            aria-describedby="telephone-aide"
            required
          />
          <span class="champ__aide" id="telephone-aide">{d.telephoneAide}</span>
        </p>
      </div>

      <div class="bloc">
        <p class="champ">
          <label class="champ__label" for="courriel">
            {d.courrielLabel} <span class="champ__marque">({d.facultatif})</span>
          </label>
          <input
            class="champ__saisie"
            type="email"
            id="courriel"
            name="courriel"
            autocomplete="email"
            aria-describedby="courriel-aide"
          />
          <span class="champ__aide" id="courriel-aide">{d.courrielAide}</span>
        </p>

        <p class="champ">
          <label class="champ__label" for="message">
            {d.messageLabel} <span class="champ__marque">({d.facultatif})</span>
          </label>
          <textarea class="champ__saisie champ__saisie--long" id="message" name="message" rows="4"
          ></textarea>
        </p>
      </div>

      {/* LE LEURRE. Il porte un vrai libellé, lié à son champ : un lecteur
          d'écran l'annonce et son utilisateur sait quoi en faire. Il est
          retiré de l'affichage, jamais de l'arbre d'accessibilité — un
          « display: none » le cacherait aussi aux lecteurs d'écran, et un
          « aria-hidden » sur un champ saisissable est une faute. */}
      <p class="leurre">
        <label class="champ__label" for="site">{d.potLabel}</label>
        <input type="text" id="site" name="site" tabindex="-1" autocomplete="off" />
      </p>

      <div class="bloc">
        <label class="accord">
          <input type="checkbox" name="consentement" value="oui" required />
          <span>{d.consentementLabel}</span>
        </label>
      </div>

      <div class="pied-formulaire">
        <button class="bouton bouton--principal" type="submit">{d.envoyer}</button>
        <p class="note">{d.reserve}</p>
      </div>
    </form>
  </div>
</section>

<style>
  .fil {
    margin-bottom: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    font-size: var(--t-petit);
  }

  .fil__liste {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .fil__liste li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
    color: var(--encre-3);
    overflow-wrap: anywhere;
  }

  .fil__lien {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-block: -0.7rem;
    color: var(--encre-3);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .fil__lien:hover {
    color: var(--encre);
    border-bottom-color: var(--givre);
  }

  /* La barre oblique EST DU TEXTE et se mesure comme tel : à la couleur des
     filets elle tomberait sous le seuil de contraste. */
  .fil__trait {
    color: var(--encre-3);
  }

  .devis__titre {
    margin-top: 0.75rem;
    font-size: var(--t-titre);
    max-width: 16ch;
  }

  .devis__intro {
    margin-top: 1rem;
    max-width: 52ch;
    color: var(--encre-2);
  }

  .devis__demo {
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    background: var(--givre-pale);
    border-left: 3px solid var(--givre);
    border-radius: 0 var(--rayon) var(--rayon) 0;
    color: var(--encre-2);
  }

  /* --- Cartes à cocher ---------------------------------------------- */
  .cartes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: 0.7rem;
  }

  .carte {
    display: block;
    cursor: pointer;
  }

  .carte__radio {
    /* Retiré de l'affichage, gardé dans l'arbre d'accessibilité : le clavier
       l'atteint, le lecteur d'écran l'annonce, et l'anneau de focus est
       reporté sur la carte. */
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .carte__corps {
    display: grid;
    gap: 0.25rem;
    min-height: 4.5rem;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--trait-champ);
    border-radius: var(--rayon);
    transition: border-color var(--duree) var(--courbe), background var(--duree) var(--courbe);
  }

  .carte__radio:checked + .carte__corps {
    border-color: var(--givre);
    background: var(--givre-pale);
    box-shadow: inset 0 0 0 1px var(--givre);
  }

  /* SUR LE FOND CLAIR DE LA CARTE COCHÉE, l'encre tertiaire tombe à 4,32:1 —
     mesuré par axe. Elle passe donc à l'encre secondaire, qui tient 6,89:1
     sur ce même fond. Une couleur juste sur le papier ne l'est pas
     forcément sur une surface teintée. */
  .carte__radio:checked + .carte__corps .carte__detail {
    color: var(--encre-2);
  }

  .carte__radio:focus-visible + .carte__corps {
    outline: 3px solid var(--givre);
    outline-offset: 2px;
  }

  .carte__nom {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .carte__detail {
    font-size: var(--t-kicker);
    line-height: 1.5;
    color: var(--encre-3);
  }

  /* --- Incrémenteur ---------------------------------------------------- */
  .compteur {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 3rem;
    max-width: 12rem;
  }

  .compteur__bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    font-size: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--trait-champ);
    border-radius: var(--rayon) 0 0 var(--rayon);
    cursor: pointer;
  }

  .compteur__bouton:last-child {
    border-radius: 0 var(--rayon) var(--rayon) 0;
  }

  .compteur__champ {
    border-radius: 0;
    border-inline: 0;
    text-align: center;
  }

  /* --- Champ avec unité ------------------------------------------------ */
  .unite {
    position: relative;
    display: block;
    max-width: 12rem;
  }

  .unite__suffixe {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--t-petit);
    color: var(--encre-3);
    pointer-events: none;
  }

  .unite .champ__saisie {
    padding-right: 3rem;
  }

  /* --- Pastilles -------------------------------------------------------- */
  .pastilles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pastille {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.5rem 0.95rem;
    background: var(--surface);
    border: 1px solid var(--trait-champ);
    border-radius: 999px;
    font-size: var(--t-petit);
    cursor: pointer;
  }

  .pastille:has(input:checked) {
    border-color: var(--givre);
    background: var(--givre-pale);
    font-weight: 600;
  }

  .pastille input {
    accent-color: var(--givre);
  }

</style>

<script is:inline define:vars={{ besoinsConnus }}>
  /**
   * LE BESOIN DEMANDÉ PAR L'ADRESSE.
   *
   * « /devis/?besoin=depannage » arrive depuis les cartes de l'accueil. La
   * liste des besoins acceptés vient du gabarit, et non d'une copie écrite
   * ici : un identifiant ajouté au contenu est reconnu du même geste.
   *
   * Le script s'exécute AVANT que le visiteur ait pu toucher quoi que ce soit,
   * et il ne fait que déplacer une coche : sans lui, la première carte reste
   * choisie, et le formulaire part quand même.
   */
  {
    const demande = new URLSearchParams(location.search).get('besoin');
    if (demande && besoinsConnus.includes(demande)) {
      const cible = document.querySelector(`input[name="besoin"][value="${demande}"]`);
      if (cible) cible.checked = true;
    }
  }
</script>

<script>
  /**
   * L'INCRÉMENTEUR.
   *
   * Un ENRICHISSEMENT, et rien de plus : sans script, le champ numérique
   * reste saisissable au clavier du téléphone, et le formulaire part. Les
   * deux boutons sont donc déjà dans le document, et ils se contentent de
   * pousser la valeur — ce que « stepUp » fait en respectant min et max.
   *
   * L'événement « input » est émis à la main : « stepUp » ne le déclenche pas,
   * et un champ dont la valeur change en silence laisserait toute
   * vérification attachée à cet événement dans l'ignorance.
   */
  for (const groupe of document.querySelectorAll<HTMLElement>('[data-compteur]')) {
    const champ = groupe.querySelector<HTMLInputElement>('input[type="number"]');
    if (!champ) continue;
    for (const bouton of groupe.querySelectorAll<HTMLButtonElement>('[data-pas]')) {
      bouton.addEventListener('click', () => {
        const pas = Number(bouton.dataset.pas);
        pas > 0 ? champ.stepUp() : champ.stepDown();
        champ.dispatchEvent(new Event('input', { bubbles: true }));
      });
    }
  }
</script>
